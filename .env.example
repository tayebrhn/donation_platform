# Stripe test-mode credentials. Never use live keys for local development.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# PostgreSQL connection settings.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional first administrator created by bin\rails db:seed.
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_secure_password

# Sender address used by password reset emails.
DEVISE_MAILER_SENDER=no-reply@example.com
