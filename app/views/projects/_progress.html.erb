<div class="campaign-progress" aria-label="Fundraising progress">
  <div class="campaign-progress__header">
    <span>Raised</span>
    <strong><%= format_money(project.amount_raised, currency: project.currency) %></strong>
  </div>
  <progress class="progress-bar" max="100" value="<%= project.progress_percentage %>">
    <%= format_percentage(project.progress_percentage) %>%
  </progress>
  <div class="campaign-progress__footer">
    <span><%= format_percentage(project.progress_percentage) %>% funded</span>
    <span><%= format_money(project.remaining_amount, currency: project.currency) %> to go</span>
  </div>
</div>
