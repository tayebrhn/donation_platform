<% content_for :title, "Edit profile | Common Ground" %>

<main id="main-content" class="site-shell account-page">
  <section class="account-panel" aria-labelledby="profile-title">
    <div class="eyebrow eyebrow--quiet">Account details</div>
    <h1 id="profile-title">Edit your profile.</h1>
    <% if current_user.errors.any? %>
      <div class="form-errors" role="alert"><ul><% current_user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div>
    <% end %>
    <%= form_with model: current_user, url: profile_path, class: "account-form" do |form| %>
      <div class="form-field"><%= form.label :name %><%= form.text_field :name, required: true, autocomplete: "name" %></div>
      <div class="form-field"><%= form.label :email %><%= form.email_field :email, required: true, autocomplete: "email" %></div>
      <%= form.submit "Save profile", class: "button button--primary button--full" %>
    <% end %>
  </section>
</main>
